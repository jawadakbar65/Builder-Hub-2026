PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/builderhub?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
APP_URL=http://127.0.0.1:5173
SERVER_URL=http://127.0.0.1:4000

# Optional: enables "Continue with Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Optional: enables the server-side AI image endpoint.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Local testing only. Real Pro upgrades must come from a verified payment webhook.
# ALLOW_FAKE_UPGRADE=true

# Set when running behind a reverse proxy so rate limits key on the real client IP.
# TRUST_PROXY=true
